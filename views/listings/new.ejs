<% layout("/layouts/boilerplate") %>


    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h2>New Listing</h2>

    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
    <div>
    <label for="title" class="form-label">Title</label>
    <input name="listing[title]" class="form-control" type="text" placeholder="Enter Title" required>
    <div class="valid-feedback">Title looks good!</div>
    <div class="invalid-feedback">Please give a title</div>
    </div>

    <br> <br>

    <div>
        <label for="description" class="form-label">Description</label>
    <textarea name="listing[description]" class="form-control" type="text" rows="10" cols="20" placeholder="Enter Description" required></textarea>
    <div class="invalid-feedback">Please write a short description</div>
    </div>

    <br><br>

     <div>
         <label for="image_url" class="form-label">Upload Listing Image </label>
    <input name="listing[image]" class="form-control" type="file" placeholder="Enter Image Url Link" required>
    </div>

    <br><br>

    <div class="row">
     <div class="mb-3 col-md-4">
         <label for="price" class="form-label">Price</label>
    <input name="listing[price]" class="form-control" type="text" placeholder=" Eg. 15000" required>
    <div class="invalid-feedback">Price should be valid</div>
    </div>

    <br><br>
<div class="mb-3 col-md-8">
     <label for="country" class="form-label">Country</label>
        <input name="listing[country]" class="form-control" type="text" placeholder="India" required>
        <div class="invalid-feedback">Country should be valid</div>
</div>

    

</div>
        <br><br>

        <div>
            <div>
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" class="form-control" type="text" placeholder="Jaipur, Rajasthan" required>
        <div class="invalid-feedback">Location should be valid</div>
    </div>
           
        <br><br>
    
    <button class="btn btn-dark btn-add mt-3">Add</button>
     <br><br>
    </form>
    </div>
    </div>
<!-- </html> -->