<% layout("/layouts/boilerplate") %>

<body>

    <div class="row mt-3">
        <div class="col-8 offset-2">

    <br><br>
    <h1>Edit Listing</h1>

    <br><br>

    
     <form method="post" action="/listings/<%= Listing._id %>?_method=put" novalidate class="needs-validation">

        <div class="mb-3">
             <label for="title" class="form-label">Title</label>
             <input name="listing[title]" class="form-control" type="text" value="<%= Listing.title %>" required>
             <div class="valid-feedback">Title looks good!</div>
            <div class="invalid-feedback">Please give a title</div>
        </div>

    <br> <br>

    <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" type="text" rows="10" cols="20" required> <%= Listing.description %> </textarea>
            <div class="invalid-feedback">Please write a short description</div>
    </div>

    <br><br>


    <div class="mb-3">
        Original Listing Image <br>
       <img src="<%= originalImageUrl %>"  class="card-img-top" alt="..." style="height: 20rem" style="width: 5rem"/>
    </div>


     <div class="mb-3">
        <label for="image" class="form-label">Upload New Image</label>
        <input name="listing[image]" class="form-control" type="file" >
    </div>

    <br><br>

    <div class="row ">
    <div class="mb-3 col-md-4">
         <label for="price" class="form-label">Price</label>
         <input name="listing[price]" type="text" class="form-control" value="<%= Listing.price %>" required>
          <div class="invalid-feedback">Price should be valid</div>
    </div>

    <br><br>

      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" type="text" class="form-control" value="<%= Listing.country %>" required>
         <div class="invalid-feedback">Country should be valid</div>
    </div>

    </div>
    <br><br>


     <div class="mb-3">
         <label for="location" class="form-label">Location</label>
        <input name="listing[location]" class="form-control" type="text" value="<%= Listing.location %>" required>
          <div class="invalid-feedback">Location should be valid</div>
    </div>


  
    
    <button class="btn btn-dark edit-btn mt-3">Submit</button> 

    <br><br>
  
    </form>

    </div>
    </div>
</body>
</html>